# Base image with all system dependencies
# Build rarely - only when OS/dependencies change
#
# Build:   docker build -f docker/Dockerfile.base -t ghcr.io/milesburton/nightwatch-cubesat-base:latest .
# Push:    docker push ghcr.io/milesburton/nightwatch-cubesat-base:latest
#
# Debian 13 (trixie) is used because GNU Radio and Direwolf are packaged there for both
# amd64 and arm64. trixie ships gr-satellites 5.5.0, which knows far fewer satellites than
# upstream, so gr-satellites is built from a pinned upstream commit instead.
# To upgrade: change GR_SATELLITES_VERSION and GR_SATELLITES_SHA together
# (gh api repos/daniestevez/gr-satellites/commits/<tag> --jq .sha; the tag is annotated, so not git/ref).

FROM debian:trixie-slim AS gr-satellites-build

ARG GR_SATELLITES_VERSION=v5.9.0
ARG GR_SATELLITES_SHA=f663ee4c8c55e713cef0ce7f10c640452adfcd5a

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    gnuradio-dev \
    libboost-dev \
    pybind11-dev \
    python3-dev \
    python3-numpy \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --branch "${GR_SATELLITES_VERSION}" https://github.com/daniestevez/gr-satellites.git /src \
    && test "$(git -C /src rev-parse HEAD)" = "${GR_SATELLITES_SHA}" \
    && cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /build -j"$(nproc)" \
    && DESTDIR=/out cmake --install /build

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    # SDR capture and audio
    rtl-sdr \
    sox \
    # Runtime dependencies of the gr-satellites build copied in below
    gnuradio \
    python3-numpy \
    python3-construct \
    python3-requests \
    python3-websocket \
    python3-yaml \
    direwolf \
    && rm -rf /var/lib/apt/lists/*

COPY --from=gr-satellites-build /out/usr/local /usr/local
RUN ldconfig

# Install Node.js 22.x LTS
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g npm@10.9.2 tsx --no-fund --loglevel=error \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN mkdir -p /app/data /app/recordings /app/images

# Verify installations work
ARG GR_SATELLITES_VERSION=v5.9.0
RUN gr_satellites --list_satellites > /tmp/satellites.txt \
    && grep -q "gr_satellites ${GR_SATELLITES_VERSION}" /tmp/satellites.txt \
    && grep -q "NORAD 43786" /tmp/satellites.txt && rm /tmp/satellites.txt \
    && command -v rtl_power rtl_sdr rtl_fm sox direwolf >/dev/null \
    && node --version && npm --version

LABEL org.opencontainers.image.title="Nightwatch Cubesat Base" \
      org.opencontainers.image.description="Base image with rtl-sdr, gr-satellites, Direwolf and Node.js runtime" \
      org.opencontainers.image.source="https://github.com/milesburton/nightwatch-cubesat"
